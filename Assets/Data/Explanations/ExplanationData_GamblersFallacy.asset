  m_Name: ExplanationData_GamblersFallacy
  m_EditorClassIdentifier: Assembly-CSharp::MindParadox.Data.ExplanationData
  puzzleId: gamblers-fallacy
  explanationTitle: "\uC5F0\uC18D\uB41C \uACB0\uACFC\uAC00 \uB2E4\uC74C \uD655\uB960\uC744 \uBC14\uAFC0\uAE4C?"
  explanationSummary: "\uACF5\uC815\uD55C \uB3D9\uC804\uC758 \uAC01 \uB358\uC9C0\uAE30\uB294 \uB3C5\uB9BD\uC785\uB2C8\uB2E4.\n\uB2E4\uC74C \uB4B7\uBA74\uC740 \uC5EC\uC804\uD788 50%\uC785\uB2C8\uB2E4."
  explanationBody: "\uAC01 \uB3D9\uC804 \uB358\uC9C0\uAE30\uB294 \uB3C5\uB9BD \uC0AC\uAC74\uC785\uB2C8\uB2E4.\n\n\uC774\uC804 \uACB0\uACFC\uAC00\n\uB2E4\uC74C \uB3D9\uC804\uC758 \uD655\uB960\uC744 \uBC14\uAFB8\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n\uC55E\uBA74\uC774 5\uBC88 \uC5F0\uC18D \uB098\uC654\uB354\uB77C\uB3C4\n\uB2E4\uC74C \uB358\uC9C0\uAE30\uB294\n\n\uC55E\uBA74 50%\n\uB4B7\uBA74 50%\n\n\uC785\uB2C8\uB2E4."
  explanationFormula: "\uB2E4\uC74C \uB358\uC9C0\uAE30 = 1/2"
  explanationKey: explanation.gamblers-fallacy
  titleKey: explanation.gamblers-fallacy.title
  summaryKey: explanation.gamblers-fallacy.summary
  bodyKey: explanation.gamblers-fallacy.body
  formulaKey: explanation.gamblers-fallacy.formula
